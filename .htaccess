# ============================================================
# QUALIMATIC PRODUCTION — Configuration Apache
# ============================================================

Options -Indexes
DirectoryIndex index.html

# ============================================================
# 1. FORCER HTTPS + WWW
# ============================================================
RewriteEngine On

# Forcer HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Forcer www
RewriteCond %{HTTP_HOST} ^qualimaticproduction\.fr$ [NC]
RewriteRule ^ https://www.qualimaticproduction.fr%{REQUEST_URI} [L,R=301]

# ============================================================
# 2. REDIRECTIONS PERMANENTES (anciennes URLs Strikingly/Wix)
# ============================================================
# Ces règles rattrapent les vieilles URLs encore indexées par Google
# (signalées en 404 dans Search Console) et transfèrent leur autorité
# vers la page vivante équivalente. NE PAS supprimer.

# --- Accueil / marque ---
RewriteRule ^hello/?$ / [R=301,L]
RewriteRule ^68f51578d9c42/?$ / [R=301,L]

# --- Contact (ancien chemin sans .html) ---
RewriteRule ^contact/?$ /contact.html [R=301,L]

# --- Anciennes pages "services" / "prestation" ---
RewriteRule ^mes-services(/.*)?$ /mariage.html [R=301,L]
RewriteRule ^prestation(/.*)?$ /corporate.html [R=301,L]

# --- Formules (ancien chemin "voir-plus") ---
RewriteRule ^voir-plus(/.*)?$ /mariage.html [R=301,L]

# --- Blog supprimé (blog, blog-1, blog/tag/..., articles) ---
RewriteRule ^blog(-1)?(/.*)?$ / [R=301,L]

# --- Ancienne plaquette PDF (chemin obsolète /assets/pdf/) ---
RewriteRule ^assets/pdf/plaquette-qualimatic\.pdf$ /mariage.html [R=301,L]

# --- URLs accentuées : on teste REQUEST_URI pour couvrir la forme
#     décodée (é) ET encodée (%C3%A9) selon le navigateur/bot ---
# /création-vidéo (+ sous-pages item-id) -> corporate
RewriteCond %{REQUEST_URI} ^/cr.+ation-vid.+o [NC]
RewriteRule ^ /corporate.html [R=301,L]
# /À-propos-de-moi -> about
RewriteCond %{REQUEST_URI} propos-de-moi [NC]
RewriteRule ^ /about.html [R=301,L]
# /voir-plus/découvrir-les-formules (sécurité si l'accent casse la règle ci-dessus)
RewriteCond %{REQUEST_URI} d.+couvrir-les-formules [NC]
RewriteRule ^ /mariage.html [R=301,L]

# ============================================================
# 3. PAGE 404 PERSONNALISÉE
# ============================================================
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# ============================================================
# 4. CACHE NAVIGATEUR (Expires)
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Images — 1 an
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/jpg                "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/gif                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

  # Vidéos — 1 an
  ExpiresByType video/mp4                "access plus 1 year"
  ExpiresByType video/webm               "access plus 1 year"

  # Polices — 1 an
  ExpiresByType font/woff                "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType application/font-woff    "access plus 1 year"
  ExpiresByType application/font-woff2   "access plus 1 year"

  # CSS / JS — 1 mois
  ExpiresByType text/css                 "access plus 1 month"
  ExpiresByType application/javascript   "access plus 1 month"
  ExpiresByType text/javascript          "access plus 1 month"

  # HTML — 1 heure (révision fréquente)
  ExpiresByType text/html                "access plus 1 hour"

  # Manifest / data
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/json         "access plus 1 hour"

  # Défaut
  ExpiresDefault                         "access plus 1 month"
</IfModule>

# Cache-Control headers (renfort)
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|gif|webp|svg|ico|woff2?|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ============================================================
# 5. COMPRESSION GZIP
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE application/font-woff
  AddOutputFilterByType DEFLATE application/font-woff2
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# ============================================================
# 6. HEADERS DE SÉCURITÉ
# ============================================================
<IfModule mod_headers.c>
  # Empêche l'embedding dans une iframe externe (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Bloque le MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Politique de référent
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Politique de permissions (caméra, micro, géoloc — désactivées par défaut)
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # HSTS — force HTTPS pendant 1 an (à activer après vérification que HTTPS marche partout)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Suppression du header X-Powered-By
  Header unset X-Powered-By
</IfModule>

# ============================================================
# 7. PROTECTION FICHIERS SENSIBLES
# ============================================================
<FilesMatch "^\.(htaccess|htpasswd|env|gitignore)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(md|log|sql|bak|swp)$">
  Require all denied
</FilesMatch>

# ============================================================
# 8. CHARSET PAR DÉFAUT
# ============================================================
AddDefaultCharset UTF-8
